<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nooraya iOS Info.plist additions for Offline Prayer Notifications, Background Audio & Schedule Top-Up.
  Merge these keys into `ios/App/App/Info.plist` after `npx cap add ios`.
  Note: Do NOT add Critical Alerts entitlement (Apple rejects non-medical/safety apps);
  use Time Sensitive notifications instead (`com.apple.developer.usernotifications.time-sensitive`).
-->
<plist version="1.0">
<dict>
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
    <string>fetch</string>
    <string>processing</string>
  </array>
  <key>BGTaskSchedulerPermittedIdentifiers</key>
  <array>
    <string>com.nooraya.quranaudio.refreshPrayers</string>
  </array>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Nooraya uses your city coordinates locally on your device to calculate accurate prayer times and Qibla direction even when offline.</string>
</dict>
</plist>
