{
  "entities": {
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User specific settings and preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user."
        },
        "theme": {
          "type": "string"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp of creation."
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of last update."
        }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}/preferences/{preferenceId}": {
      "schema": "UserPreferences",
      "description": "User preferences stored securely for each user."
    }
  }
}
