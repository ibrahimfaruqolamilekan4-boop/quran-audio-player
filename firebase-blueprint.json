{
  "entities": {
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User specific settings and preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "theme": {
          "type": "string",
          "maxLength": 100
        },
        "activeBackgroundVideoId": {
          "type": "string",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "number"
        },
        "ambientVideoMapping": {
          "type": "object"
        }
      },
      "required": [
        "userId"
      ]
    },
    "CustomReciter": {
      "title": "CustomReciter",
      "description": "User uploaded custom reciter configurations",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "serverUrl": {
          "type": "string",
          "maxLength": 300
        },
        "style": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "userId",
        "name",
        "serverUrl"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Top-level user profile.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 255
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "number"
        },
        "lastLoginAt": {
          "type": "number"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "admin"
          ]
        }
      },
      "required": [
        "userId"
      ]
    },
    "AmbientSound": {
      "title": "AmbientSound",
      "description": "Global ambient sound configuration including video URLs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "audioUrl": {
          "type": "string",
          "maxLength": 500
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "isCustom": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/preferences/{preferenceId}": {
      "schema": "UserPreferences",
      "description": "User preferences stored securely for each user."
    },
    "/users/{userId}/customReciters/{reciterId}": {
      "schema": "CustomReciter",
      "description": "User's custom reciters."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document."
    },
    "/ambient_sounds/{soundId}": {
      "schema": "AmbientSound",
      "description": "Global configuration for ambient sounds and background videos."
    }
  }
}