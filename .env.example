# Neon Postgres connection string (Project Dashboard -> Connection Details -> Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me

# Email that automatically receives the 'admin' role on signup
ADMIN_EMAIL=you@example.com

# Flutterwave v3 Payment Gateway Credentials
# Public Key for frontend inline checkout (https://dashboard.flutterwave.com/settings/apis)
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxx-X
# Secret Key for backend server verification
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx-X
# Secret Hash for webhook signature verification
FLW_WEBHOOK_HASH=your_flutterwave_secret_hash
