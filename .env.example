# Neon Postgres connection string (Project Dashboard -> Connection Details -> Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me

# Email that automatically receives the 'admin' role on signup
ADMIN_EMAIL=you@example.com

# Flutterwave v3 Payment Gateway Credentials (https://dashboard.flutterwave.com/settings/apis)
# Public Key for client-side checkout
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxx-X
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxx-X

# Secret Key for backend server verification & dynamic virtual account creation
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx-X

# Encryption Key for payload verification
FLW_ENCRYPTION_KEY=FLWSECK_TEST_ENC-xxxxxxxxxxxxx

# Secret Hash for webhook signature verification (Settings -> Webhooks in Flutterwave Dashboard)
FLW_WEBHOOK_HASH=your_flutterwave_secret_hash

# Supabase Storage & Ambient Backgrounds (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Web Push Notifications (Phase 3 - Generate via: npx web-push generate-vapid-keys)
# Public key is shared with the browser PushManager; Private key stays strictly in server env.
VITE_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=change-me-cron-secret

